---
import { cn } from "@lib/utils";

interface Props {
  prompt: string;
  title?: string;
  model?: string;
  aspectRatio?: string;
  negativePrompt?: string;
  seed?: string | number;
  cfgScale?: string | number;
  image?: string;
  imageAlt?: string;
  tags?: string[];
  class?: string;
}

const {
  prompt,
  title,
  model,
  aspectRatio,
  negativePrompt,
  seed,
  cfgScale,
  image,
  imageAlt = "AI generated prompt preview",
  tags,
  class: className,
} = Astro.props;
---

<div
  class={cn(
    "group/card my-5 overflow-hidden rounded-xl border border-black/15 dark:border-white/20 bg-black/[0.02] dark:bg-white/[0.03] backdrop-blur-sm transition-all duration-300 hover:border-black/30 dark:hover:border-white/35 shadow-sm hover:shadow-md",
    image ? "p-0" : "p-0",
    className,
  )}
>
  <!-- Header Bar -->
  <div
    class="flex flex-wrap items-center justify-between gap-2 border-b border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 px-4 py-2.5"
  >
    <div class="flex flex-wrap items-center gap-2">
      <!-- Model Badge (if provided) -->
      {
        model && (
          <span class="inline-flex items-center gap-1.5 rounded-full border border-black/15 dark:border-white/20 bg-white dark:bg-neutral-900 px-2.5 py-0.5 text-xs font-semibold text-black dark:text-white shadow-2xs">
            <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse" />
            {model}
          </span>
        )
      }

      <!-- Aspect Ratio Badge (if provided) -->
      {
        aspectRatio && (
          <span class="inline-flex items-center gap-1 rounded-full border border-black/10 dark:border-white/15 bg-black/[0.04] dark:bg-white/[0.06] px-2 py-0.5 text-xs font-mono text-black/75 dark:text-white/75">
            <svg
              class="size-3 stroke-current"
              viewBox="0 0 24 24"
              fill="none"
              stroke-width="2"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
            </svg>
            {aspectRatio}
          </span>
        )
      }

      <!-- Optional Title -->
      {
        title && (
          <span class="text-xs font-semibold text-black dark:text-white">
            {title}
          </span>
        )
      }
    </div>

    <!-- 1-Click Copy Button -->
    <button
      type="button"
      data-prompt-copy
      data-prompt-text={prompt}
      class="prompt-copy-btn group relative inline-flex items-center gap-1.5 rounded-lg border border-black/15 dark:border-white/20 bg-white dark:bg-neutral-900 px-3 py-1.5 text-xs font-medium text-black dark:text-white shadow-xs transition-all duration-200 hover:bg-black/5 dark:hover:bg-white/10 hover:border-black/30 dark:hover:border-white/40 active:scale-95 cursor-pointer select-none"
      aria-label="Copy AI prompt to clipboard"
    >
      <svg
        class="copy-icon size-3.5 stroke-current transition-transform group-hover:scale-110"
        viewBox="0 0 24 24"
        fill="none"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
        ></path>
      </svg>
      <svg
        class="check-icon hidden size-3.5 stroke-emerald-500"
        viewBox="0 0 24 24"
        fill="none"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span class="btn-text">Copy Prompt</span>
    </button>
  </div>

  <!-- Content Body -->
  <div class="grid grid-cols-1 gap-4 p-4 md:grid-cols-12">
    <!-- Prompt Text -->
    <div
      class={cn(
        "flex flex-col justify-center",
        image ? "md:col-span-7 lg:col-span-8" : "md:col-span-12",
      )}
    >
      <div class="relative rounded-lg bg-black/[0.02] dark:bg-white/[0.02] p-3 border border-black/5 dark:border-white/5">
        <p
          class="font-mono text-xs md:text-sm leading-relaxed text-black/90 dark:text-white/90 select-all whitespace-pre-wrap"
        >
          {prompt}
        </p>
      </div>

      <!-- Optional Tag Pills -->
      {
        tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mt-2.5">
            {tags.map((tag) => (
              <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/10 text-black/70 dark:text-white/70">
                #{tag}
              </span>
            ))}
          </div>
        )
      }

      <!-- Negative Prompt or Parameters Drawer (if available) -->
      {
        (negativePrompt || seed || cfgScale) && (
          <details class="group mt-3 border-t border-black/10 dark:border-white/10 pt-2 text-xs">
            <summary class="flex cursor-pointer items-center gap-1 font-medium text-black/60 dark:text-white/60 hover:text-black dark:hover:text-white transition-colors">
              <svg
                class="size-3.5 transition-transform duration-200 group-open:rotate-90 stroke-current"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2.5"
              >
                <polyline points="9 18 15 12 9 6" />
              </svg>
              Advanced Parameters (Negative Prompt / Seed)
            </summary>
            <div class="mt-2 space-y-1.5 pl-4 text-black/75 dark:text-white/75 font-mono text-[11px]">
              {negativePrompt && (
                <div>
                  <span class="font-semibold text-black/90 dark:text-white/90">
                    Negative Prompt:{" "}
                  </span>
                  <span>{negativePrompt}</span>
                </div>
              )}
              {seed && (
                <div>
                  <span class="font-semibold text-black/90 dark:text-white/90">
                    Seed:{" "}
                  </span>
                  <span>{seed}</span>
                </div>
              )}
              {cfgScale && (
                <div>
                  <span class="font-semibold text-black/90 dark:text-white/90">
                    CFG Scale:{" "}
                  </span>
                  <span>{cfgScale}</span>
                </div>
              )}
            </div>
          </details>
        )
      }
    </div>

    <!-- Preview Image (if provided) -->
    {
      image && (
        <div class="md:col-span-5 lg:col-span-4 flex items-center justify-center">
          <div class="group/img relative overflow-hidden rounded-lg border border-black/10 dark:border-white/15 bg-black/5 dark:bg-white/5 w-full shadow-xs">
            <img
              src={image}
              alt={imageAlt}
              loading="lazy"
              class="aspect-square w-full object-cover transition-transform duration-500 group-hover/img:scale-105"
            />
            <div class="absolute bottom-2 right-2 rounded-md bg-black/75 px-2 py-0.5 text-[10px] font-medium text-white backdrop-blur-md border border-white/10">
              Sample Output
            </div>
          </div>
        </div>
      )
    }
  </div>
</div>

<script>
  function setupPromptCopyButtons() {
    const buttons = document.querySelectorAll("[data-prompt-copy]");
    buttons.forEach((btn) => {
      if (btn.hasAttribute("data-has-copy-listener")) return;
      btn.setAttribute("data-has-copy-listener", "true");

      btn.addEventListener("click", async () => {
        const text = btn.getAttribute("data-prompt-text");
        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);
          const copyIcon = btn.querySelector(".copy-icon");
          const checkIcon = btn.querySelector(".check-icon");
          const btnText = btn.querySelector(".btn-text");

          if (copyIcon && checkIcon && btnText) {
            copyIcon.classList.add("hidden");
            checkIcon.classList.remove("hidden");
            btnText.textContent = "Copied!";
            btn.classList.add("border-emerald-500/50", "bg-emerald-500/10");

            setTimeout(() => {
              copyIcon.classList.remove("hidden");
              checkIcon.classList.add("hidden");
              btnText.textContent = "Copy Prompt";
              btn.classList.remove(
                "border-emerald-500/50",
                "bg-emerald-500/10",
              );
            }, 2000);
          }
        } catch (err) {
          console.error("Failed to copy prompt:", err);
        }
      });
    });
  }

  document.addEventListener("astro:page-load", setupPromptCopyButtons);
  document.addEventListener("DOMContentLoaded", setupPromptCopyButtons);
  setupPromptCopyButtons();
</script>
