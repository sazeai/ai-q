---
import { SITE, SEO, ADSENSE, ANALYTICS } from "@consts"

interface ArticleData {
  title: string
  description: string
  datePublished: Date
  dateModified?: Date
  author?: string
  image?: string
  tags?: string[]
  faq?: { question: string, answer: string }[]
}

interface Props {
  title: string
  description: string
  image?: string
  canonicalUrl?: string
  type?: "website" | "article"
  article?: ArticleData
  noindex?: boolean
}

const {
  title,
  description,
  image = SEO.OG_IMAGE,
  canonicalUrl,
  type = "website",
  article,
  noindex = false,
} = Astro.props

const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://ai-q.in"
const currentCanonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site).toString()
const ogImageUrl = image.startsWith("http") ? image : `${siteUrl}${image.startsWith("/") ? "" : "/"}${image}`
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
{noindex && <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Language & Geo -->
<meta http-equiv="content-language" content={SITE.LANGUAGE} />

<!-- Preload critical fonts -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin>
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin>

<!-- Canonical URL -->
<link rel="canonical" href={currentCanonical} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={article?.author || SITE.AUTHOR} />
{article?.tags && article.tags.length > 0 && (
  <meta name="keywords" content={article.tags.join(", ")} />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={currentCanonical} />
<meta property="og:site_name" content={SITE.TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content={SEO.LOCALE} />

{type === "article" && article && (
  <>
    <meta property="article:published_time" content={article.datePublished.toISOString()} />
    <meta property="article:modified_time" content={(article.dateModified || article.datePublished).toISOString()} />
    <meta property="article:author" content={article.author || SITE.AUTHOR} />
    {article.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SEO.TWITTER_HANDLE} />
<meta name="twitter:creator" content={SEO.TWITTER_HANDLE} />
<meta name="twitter:url" content={currentCanonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Google Search Console Verification -->
{SEO.GOOGLE_SITE_VERIFICATION && (
  <meta name="google-site-verification" content={SEO.GOOGLE_SITE_VERIFICATION} />
)}

<!-- Sitemap & RSS Feed -->
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.TITLE} href={`${siteUrl}/rss.xml`}/>

<!-- Google AdSense Auto-Ads -->
{ADSENSE.ENABLED && ADSENSE.CLIENT_ID && (
  <script
    is:inline
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.CLIENT_ID}`}
    crossorigin="anonymous"
  ></script>
)}

<!-- Google Analytics (gtag.js) -->
{ANALYTICS.GOOGLE_ANALYTICS_ID && (
  <>
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.GOOGLE_ANALYTICS_ID}`}
    ></script>
    <script is:inline define:vars={{ gaId: ANALYTICS.GOOGLE_ANALYTICS_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}

<!-- Global Scripts -->
<script is:inline src="/js/theme.js"></script>
<script is:inline src="/js/scroll.js"></script>
<script is:inline src="/js/animate.js"></script>
<script defer is:inline src="/js/copy.js"></script>

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client"
  document.addEventListener("astro:before-swap", (e) =>
    [
      ...(e as TransitionBeforeSwapEvent).newDocument.head.querySelectorAll(
        "link[as=\"font\"]"
      ),
    ].forEach((link) => link.remove())
  )
</script>
