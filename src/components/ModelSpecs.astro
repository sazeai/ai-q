---
import { cn } from "@lib/utils"

interface SpecItem {
  label: string
  value: string
}

interface Props {
  title?: string
  subtitle?: string
  items: SpecItem[]
  class?: string
}

const {
  title = "Model Specifications & Technical Overview",
  subtitle = "Verified specs and system capabilities",
  items = [],
  class: className,
} = Astro.props
---

<div class={cn("my-8 overflow-hidden rounded-xl border border-black/15 dark:border-white/20 bg-black/[0.02] dark:bg-white/[0.02] p-5 md:p-6 backdrop-blur-sm", className)}>
  <div class="flex items-center gap-2 border-b border-black/10 dark:border-white/10 pb-4 mb-4">
    <div class="flex size-8 items-center justify-center rounded-lg bg-black/5 dark:bg-white/10 text-black dark:text-white">
      <svg class="size-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="3" rx="2"/>
        <path d="M3 9h18"/>
        <path d="M9 21V9"/>
      </svg>
    </div>
    <div>
      <h3 class="text-base font-bold text-black dark:text-white leading-none">{title}</h3>
      {subtitle && <span class="text-xs text-black/60 dark:text-white/60">{subtitle}</span>}
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
    {items.map((spec) => (
      <div class="rounded-lg border border-black/5 dark:border-white/10 bg-white/70 dark:bg-neutral-900/60 p-3 flex flex-col justify-between">
        <span class="text-[11px] uppercase tracking-wider font-semibold text-black/50 dark:text-white/50">
          {spec.label}
        </span>
        <span class="text-xs md:text-sm font-medium text-black/90 dark:text-white/90 mt-1">
          {spec.value}
        </span>
      </div>
    ))}
  </div>
</div>
