---
interface Props {
  type?: "default" | "info" | "warning" | "error";
  class?: string;
}

const { type = "default", class: className } = Astro.props;

let emoji = "💡";
if (type === "info") {
  emoji = "ℹ️";
} else if (type === "warning") {
  emoji = "⚠️";
} else if (type === "error") {
  emoji = "🚨";
}

const baseClasses =
  "relative my-4 flex items-start gap-3 rounded-lg border p-4 text-sm";
const typeClasses = {
  default:
    "border-amber-600 bg-amber-100/60 text-amber-950 dark:border-amber-500/40 dark:bg-amber-950/20 dark:text-amber-200",
  info: "border-blue-600 bg-blue-100/60 text-blue-950 dark:border-blue-500/40 dark:bg-blue-950/20 dark:text-blue-200",
  warning:
    "border-yellow-600 bg-yellow-100/60 text-yellow-950 dark:border-yellow-500/40 dark:bg-yellow-950/20 dark:text-yellow-200",
  error:
    "border-red-600 bg-red-100/60 text-red-950 dark:border-red-500/40 dark:bg-red-950/20 dark:text-red-200",
};
---

<div class:list={["not-prose", baseClasses, typeClasses[type], className]}>
  <span class="pointer-events-none select-none text-xl leading-none"
    >{emoji}</span
  >
  <div class="flex-1 leading-relaxed">
    <slot />
  </div>
</div>
