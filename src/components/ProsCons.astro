---
import { cn } from "@lib/utils"

interface Props {
  prosTitle?: string
  consTitle?: string
  pros: string[]
  cons: string[]
  class?: string
}

const {
  prosTitle = "What It Nails (Strengths)",
  consTitle = "Where It Falls Short (Limitations)",
  pros = [],
  cons = [],
  class: className,
} = Astro.props
---

<div class={cn("my-8 grid grid-cols-1 md:grid-cols-2 gap-4", className)}>
  <!-- Pros Card -->
  <div class="rounded-xl border border-emerald-500/25 bg-emerald-500/[0.03] dark:bg-emerald-500/[0.05] p-5">
    <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold text-base mb-3">
      <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500/20">
        <svg class="size-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="3">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>
      <span>{prosTitle}</span>
    </div>
    <ul class="space-y-2.5 text-xs md:text-sm text-black/85 dark:text-white/85">
      {pros.map((pro) => (
        <li class="flex items-start gap-2">
          <svg class="size-4 shrink-0 text-emerald-500 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>{pro}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Cons Card -->
  <div class="rounded-xl border border-rose-500/25 bg-rose-500/[0.03] dark:bg-rose-500/[0.05] p-5">
    <div class="flex items-center gap-2 text-rose-600 dark:text-rose-400 font-bold text-base mb-3">
      <div class="flex size-6 items-center justify-center rounded-full bg-rose-500/20">
        <svg class="size-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="3">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </div>
      <span>{consTitle}</span>
    </div>
    <ul class="space-y-2.5 text-xs md:text-sm text-black/85 dark:text-white/85">
      {cons.map((con) => (
        <li class="flex items-start gap-2">
          <svg class="size-4 shrink-0 text-rose-500 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
          <span>{con}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
