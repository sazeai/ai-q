---
import { cn } from "@lib/utils"

interface Props {
  before: string
  after: string
  beforeLabel?: string
  afterLabel?: string
  alt?: string
  class?: string
}

const {
  before,
  after,
  beforeLabel = "Original / Base",
  afterLabel = "AI Gemini Enhanced",
  alt = "AI Image comparison before and after",
  class: className,
} = Astro.props
---

<div class={cn("my-8 overflow-hidden rounded-xl border border-black/15 dark:border-white/20 shadow-md", className)}>
  <div class="relative aspect-[4/3] md:aspect-[16/9] w-full select-none overflow-hidden bg-black/5 dark:bg-white/5 comparison-container">
    <!-- After Image (Background) -->
    <img
      src={after}
      alt={`${alt} - ${afterLabel}`}
      loading="lazy"
      class="absolute inset-0 size-full object-cover"
    />
    <span class="absolute bottom-3 right-3 z-10 rounded-md bg-black/75 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur-md">
      {afterLabel}
    </span>

    <!-- Before Image (Clipped Overlay) -->
    <div class="before-layer absolute inset-0 overflow-hidden" style="width: 50%;">
      <img
        src={before}
        alt={`${alt} - ${beforeLabel}`}
        loading="lazy"
        class="absolute inset-0 size-full max-w-none object-cover"
        style="width: 100%; height: 100%;"
      />
      <span class="absolute bottom-3 left-3 z-10 rounded-md bg-black/75 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur-md">
        {beforeLabel}
      </span>
    </div>

    <!-- Drag Slider Handle -->
    <div
      class="slider-handle absolute bottom-0 top-0 z-20 w-1 -translate-x-1/2 cursor-ew-resize bg-white shadow-[0_0_10px_rgba(0,0,0,0.5)]"
      style="left: 50%;"
    >
      <div class="absolute top-1/2 left-1/2 flex size-8 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-black/20 bg-white dark:bg-neutral-900 text-black dark:text-white shadow-lg transition-transform active:scale-110">
        <svg class="size-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        <svg class="size-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<script>
  function setupComparisonSliders() {
    const containers = document.querySelectorAll('.comparison-container')
    containers.forEach((container) => {
      if (container.hasAttribute('data-slider-ready')) return
      container.setAttribute('data-slider-ready', 'true')

      const beforeLayer = container.querySelector('.before-layer') as HTMLElement
      const handle = container.querySelector('.slider-handle') as HTMLElement
      const beforeImg = beforeLayer?.querySelector('img') as HTMLElement

      if (!beforeLayer || !handle || !beforeImg) return

      let isDragging = false

      const updateSlider = (clientX: number) => {
        const rect = container.getBoundingClientRect()
        let posX = clientX - rect.left
        posX = Math.max(0, Math.min(posX, rect.width))
        const percent = (posX / rect.width) * 100

        beforeLayer.style.width = `${percent}%`
        handle.style.left = `${percent}%`
        beforeImg.style.width = `${rect.width}px`
      }

      // Sync image width on resize
      const syncImgWidth = () => {
        const rect = container.getBoundingClientRect()
        beforeImg.style.width = `${rect.width}px`
      }
      window.addEventListener('resize', syncImgWidth)
      syncImgWidth()

      // Mouse Events
      container.addEventListener('mousedown', (e) => {
        isDragging = true
        updateSlider((e as MouseEvent).clientX)
      })

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return
        updateSlider((e as MouseEvent).clientX)
      })

      window.addEventListener('mouseup', () => {
        isDragging = false
      })

      // Touch Events
      container.addEventListener('touchstart', (e) => {
        isDragging = true
        updateSlider((e as TouchEvent).touches[0].clientX)
      }, { passive: true })

      window.addEventListener('touchmove', (e) => {
        if (!isDragging) return
        updateSlider((e as TouchEvent).touches[0].clientX)
      }, { passive: true })

      window.addEventListener('touchend', () => {
        isDragging = false
      })
    })
  }

  document.addEventListener('astro:page-load', setupComparisonSliders)
  document.addEventListener('DOMContentLoaded', setupComparisonSliders)
  setupComparisonSliders()
</script>
