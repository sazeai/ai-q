---
import { type CollectionEntry, getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import ArticleTopLayout from "@layouts/ArticleTopLayout.astro"
import ArticleBottomLayout from "@layouts/ArticleBottomLayout.astro"

// Create the static AI models pages
export async function getStaticPaths() {
	const models = await getCollection("ai-models")
	return models.map((model) => ({
		params: { slug: model.slug },
		props: model,
	}))
}

// Get the requested AI model entry
type Props = CollectionEntry<"ai-models">
const model = Astro.props
const { title, summary, date, updatedDate, image, tags, author, faq } = model.data

const articleData = {
  title,
  description: summary,
  datePublished: date,
  dateModified: updatedDate,
  author,
  image,
  tags,
  faq,
}
---

<PageLayout
  title={title}
  description={summary}
  image={image}
  type="article"
  article={articleData}
>
  <TopLayout>
    <div class="animate">
      <ArticleTopLayout entry={model} />
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <ArticleBottomLayout entry={model} />
    </div>
  </BottomLayout>
</PageLayout>