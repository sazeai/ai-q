---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import SearchCollection from "@components/SearchCollection";
import { AI_MODELS } from "@consts";

const models = (await getCollection("ai-models"))
  .filter((model) => !model.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const tags = [
  ...new Set(models.flatMap((model) => model.data.tags)),
].sort((a: string, b: string) => a.localeCompare(b));

const estimated_initial_size =
  28 + models.length * 158 + (models.length - 1) * 12;
---

<PageLayout title={AI_MODELS.TITLE} description={AI_MODELS.DESCRIPTION}>
  <TopLayout>
    <div class="animate">
      <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">
        {AI_MODELS.TITLE}
      </h1>
      <div class="mt-1">
        {AI_MODELS.DESCRIPTION}
      </div>
    </div>
  </TopLayout>
  <BottomLayout>
    <div
      id="search-collection-wrapper"
      class="animate"
      style={{ minHeight: `${estimated_initial_size}px` }}
    >
      <SearchCollection
        client:load
        entry_name={"AI Models"}
        tags={tags}
        data={models}
      />
    </div>
  </BottomLayout>
</PageLayout>
